<!--
    Virtual KM Switch's design language, layered over the Fluent theme.

    Text gets its colour by inheritance from the window, not from a TextBlock style: a global
    TextBlock style would also reach the TextBlocks Fluent creates inside buttons and text boxes and
    override their colours. Variants are opt-in classes instead.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Surfaces ==================== -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--
        The panel everything sits in. Rounded and hairline-bordered rather than shadowed: a soft 1px
        edge separates a card from the page at any size, whereas a drop shadow has to be retuned for
        every background it lands on.
    -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Same shape, accent-tinted: for the one thing on a page that wants to be noticed. -->
    <Style Selector="Border.card.accent">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- A row inside a card: no border of its own, just a rounded area. -->
    <Style Selector="Border.row">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--
        A key chord, boxed so it reads as something you press rather than something you read.
        Centred vertically: the description beside it wraps at narrow widths, and a pill pinned to
        the top of a taller row sits apart from the text it labels.
    -->
    <Style Selector="Border.chord">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- An initial in a rounded tile: a list of identical grey rows is hard to scan. -->
    <Style Selector="Border.tile">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.tile > TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Status dots. A filled dot rather than a coloured word: it reads before the text does. State
        is a class, so the theme decides the colour and a theme change repaints it.
    -->
    <Style Selector="Border.dot">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.dot.positive">
        <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
    </Style>
    <Style Selector="Border.dot.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.dot.negative">
        <Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
    </Style>

    <!--
        An agent chip. Only the dot carries the state: the outline and label stay neutral. Colouring
        the whole chip made two failed agents shout across the card, and made the chips look like
        the thing that had gone wrong rather than a readout of something else.
    -->
    <Style Selector="Border.chip">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
    </Style>

    <!-- ==================== Type ==================== -->

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Small, spaced and uppercase (written that way in the markup), so a card's subject registers
        as a label rather than competing with the content underneath it.
    -->
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.strong">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Identifiers, key chords and thumbprints: things read character by character. -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.metric">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ==================== Buttons ==================== -->

    <!--
        An ordinary filled button: the default for anything that is not the page's main action, so a
        control added later cannot silently reintroduce a colour this design does not use.

        Every state is spelled out, pressed included. A control that does not acknowledge being held
        reads as unresponsive on a slow action, which is exactly when the feedback matters most.
        Fluent paints its states on the template's presenter, so that is where they are overridden.
    -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- The page's main action. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- Row-level actions: smaller, and quiet until the pointer arrives. -->
    <Style Selector="Button.ghost">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- A destructive action never looks like the others, even at row scale. -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
    </Style>

    <!-- ==================== Navigation rail and segmented control ==================== -->

    <!--
        A navigation item. A button with a bare template, so it is keyboard-reachable and announced
        as a button, while looking like a row. The selected state is a class this code sets from
        the page actually showing, never one a renderer infers.
    -->
    <Style Selector="Button.nav, Button.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.segment">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button.nav:pointerover, Button.segment:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    </Style>

    <Style Selector="Button.segment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Selection outranks hover: where you are matters more than where the pointer is. -->
    <Style Selector="Button.nav.selected, Button.segment.selected">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.nav TextBlock.icon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nav.selected TextBlock.icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.nav:disabled">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
        The button that opens and closes the navigation rail, drawn as a side-panel glyph from shapes
        rather than an icon font, so it looks the same whichever Segoe icon set is installed.
    -->
    <Style Selector="Button.paneToggle">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Border
                        Width="17"
                        Height="14"
                        BorderThickness="1.3"
                        CornerRadius="3"
                        BorderBrush="{TemplateBinding Foreground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Border Width="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.paneToggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

</Styles>
