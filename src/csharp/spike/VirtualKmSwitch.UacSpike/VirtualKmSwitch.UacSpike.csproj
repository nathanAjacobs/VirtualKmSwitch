<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway harness for the UAC / secure-desktop spike. Not shipped.
    Runs in two modes: as a LocalSystem service, and as the session agent it spawns.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VirtualKmSwitch.UacSpike</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VirtualKmSwitch.Core\VirtualKmSwitch.Core.csproj" />
    <ProjectReference Include="..\..\VirtualKmSwitch.Interop\VirtualKmSwitch.Interop.csproj" />
  </ItemGroup>

</Project>
